{
    "_comment": "Parameter mapping between SURFEX variable names (left column) in netcdf files and observation variable names. Entries can be either a plain string (direct passthrough: netcdf_name -> output_name) or an object describing a derived/postprocessed variable (see TAU and Bowen_ratio below).",

    "RI_ISBA": "RI",
    "H_ISBA": "H",
    "LE_ISBA": "LE",
    "WG1_ISBA": "SWCi_1",
    "WG2_ISBA": "SWCi_2",
    "WG3_ISBA": "SWCi_3",
    "WG4_ISBA": "SWCi_4",
    "WG5_ISBA": "SWCi_5",
    "WG6_ISBA": "SWCi_6",
    "WG7_ISBA": "SWCi_7",
    "WG8_ISBA": "SWCi_8",
    "TG1_ISBA": "TSi_1",
    "TG2_ISBA": "TSi_2",
    "TG3_ISBA": "TSi_3",
    "TG4_ISBA": "TSi_4",
    "TG5_ISBA": "TSi_5",
    "TG6_ISBA": "TSi_6",
    "TG7_ISBA": "TSi_7",
    "TG8_ISBA": "TSi_8",
    "LWU_ISBA": "LW_OUT",
    "LWD_ISBA": "LW_IN",
    "SWU_ISBA": "SW_OUT",
    "SWD_ISBA": "SW_IN",
    "T2M_ISBA": "T2m",
    "Q2M_ISBA": "Q2m",
    "W10M_ISBA": "S10m",

    "TAU": {
        "type": "derived",
        "inputs": ["FMU_ISBA", "FMV_ISBA"],
        "expression": "-sqrt(FMU_ISBA**2 + FMV_ISBA**2)",
        "units": "N m-2"
    },
    "Bowen_ratio": {
        "type": "derived",
        "inputs": ["H","LE"],
        "constants": {"factor": 1},
        "expression": "(H/LE) * factor",
        "units": ""
    }
}
