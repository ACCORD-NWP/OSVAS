+
+      # Helper to filter a harp_list by month value, preserving attributes.
+      # The threshold element ([[2]]) is never filtered — fn_split_thr crashes if it is empty.
+      filter_by_month <- function(vt, mm) {
+        result <- vector("list", length(vt))
+        names(result) <- names(vt)
+        for (i in seq_along(vt)) {
+          df <- vt[[i]]
+          if (i == 2) {
+            result[[i]] <- df  # Always pass threshold scores unchanged
+          } else if (is.data.frame(df) && "month" %in% names(df)) {
+            result[[i]] <- dplyr::filter(df, month == mm)
+          } else {
+            result[[i]] <- df
+          }
+        }
+        attributes(result) <- attributes(vt)
+        result
+      }
+
+      # All-period PNGs: filter summary scores to month=="All", month="All" in filename
